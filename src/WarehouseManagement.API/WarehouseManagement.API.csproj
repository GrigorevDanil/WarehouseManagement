<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net8.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <InvariantGlobalization>true</InvariantGlobalization>
    </PropertyGroup>

    <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
      <DocumentationFile>bin\Debug\WarehouseManagement.API.xml</DocumentationFile>
    </PropertyGroup>

    <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
      <DocumentationFile>bin\Release\WarehouseManagement.API.xml</DocumentationFile>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="FluentValidation.DependencyInjectionExtensions" Version="12.0.0" />
        <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="9.0.7">
          <PrivateAssets>all</PrivateAssets>
          <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="Scrutor" Version="6.1.0" />
        <PackageReference Include="Swashbuckle.AspNetCore" Version="6.4.0"/>
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\ClientManagement\Infrastructure\WarehouseManagement.ClientManagement.Infrastructure\WarehouseManagement.ClientManagement.Infrastructure.csproj" />
      <ProjectReference Include="..\ClientManagement\Presentation\WarehouseManagement.ClientManagement.Presentation\WarehouseManagement.ClientManagement.Presentation.csproj" />
      <ProjectReference Include="..\ResourceManagement\Infrastructure\WarehouseManagement.ResourceManagement.Infrastructure\WarehouseManagement.ResourceManagement.Infrastructure.csproj" />
      <ProjectReference Include="..\ResourceManagement\Presentation\WarehouseManagement.ResourceManagement.Presentation\WarehouseManagement.ResourceManagement.Presentation.csproj" />
      <ProjectReference Include="..\Shared\WarehouseManagement.Core\WarehouseManagement.Core.csproj" />
    </ItemGroup>
    
</Project>
